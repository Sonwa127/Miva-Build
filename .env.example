# Copy this file to .env in the same folder to customize the AI provider.
# The .env file is private and listed in .gitignore.
# The app works locally without a cloud key using its deterministic offline mode.
ARCHIVE_LLM_PROVIDER=offline

# To use Mistral instead, set the provider and add your key:
# ARCHIVE_LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your-key-here

# Optional settings:
# ARCHIVE_LLM_MODEL=mistral-small-latest
# ARCHIVE_MIN_SCORE=0.30

# Administrator setup: run python manage_admin.py; there is no default password.
# Keep this entire directory on persistent storage when hosting the site:
# ARCHIVE_DATA_DIR=data
# Development-only file watching (off by default):
# ARCHIVE_RELOAD=1

# Optional: Dailymotion requires your own Player ID for ordinary video/playlist
# links. Full geo.dailymotion.com player embed URLs carry their own Player ID.
# ARCHIVE_DAILYMOTION_PLAYER_ID=your-real-player-id

# Student accounts (see ACCOUNTS.md). Set these on the public server:
# ARCHIVE_REQUIRE_LOGIN=1
# ARCHIVE_ALLOWED_EMAIL_DOMAINS=school.edu.ng   # optional: only these emails may sign up
# ARCHIVE_PUBLIC_URL=https://study.example.com  # used to build one-time links
